{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": [
      "scripts/zeroact-test-commons/**/*.js",
      "tests/property/**/*.js",
      "tests/e2e/**/*.js"
    ]
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": "off",
        "noExplicitAny": "off",
        "noAssignInExpressions": "off"
      },
      "style": {
        "useNodejsImportProtocol": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "useArrowFunction": "off"
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "javascript": {
    "globals": ["dlog", "DEBUG", "Meter", "GPS", "FB", "fc", "describe", "it", "expect", "beforeEach", "afterEach", "beforeAll", "afterAll"]
  }
}
