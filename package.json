{
  "dependencies": {
    "iconv-lite": "^0.7.2"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite --port 5174 --host",
    "lint": "eslint '**/*.js' --fix",
    "format": "prettier --write '**/*.{js,css,html}'",
    "stylelint": "stylelint '**/*.{css,html}' --fix",
    "audit": "npm audit --audit-level=moderate",
    "audit:handlers": "node scripts/zeroact-test-commons/audit-message-handlers.js audit-handlers.config.js",
    "audit:semgrep": "semgrep --config scripts/zeroact-test-commons/semgrep-rules/daikome/ js/",
    "audit:knip": "knip --no-exit-code",
    "audit:deps": "dependency-cruiser --config dependency-cruiser.config.mjs js/ scripts/zeroact-test-commons/",
    "audit:biome": "biome check .",
    "audit:arch": "vitest run --config vitest.arch.config.js",
    "check": "npm run lint && npm run format && npm run stylelint && npm run audit",
    "test": "vitest run",
    "test:names": "node scripts/last-red.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run tests/property",
    "test:replay": "node tests/replay-mm.js",
    "test:replay-display": "node tests/verify-display-smoothness.js",
    "test:verify-9677": "node tests/verify-new-meter-9677.js",
    "test:mm-priority": "node tests/meter-mm-priority.js",
    "test:gate-snap": "node tests/gate-snap-accuracy.js",
    "test:sim-cert": "node tests/sim-fullpipeline-montecarlo.js 30 --cert-strict",
    "test:gate-kp": "node tests/truedist-kp-gate.js fixtures/0610b-Android.json --eps=0",
    "test:obd-engine": "node tests/truedist-obd-engine-gate.js",
    "test:k-neverover": "node tests/truedist-obd-engine-gate.js --k-neverover",
    "test:quant": "node tests/truedist-obd-engine-gate.js --quant",
    "test:gate-doppler": "node tests/gate-realdevice-doppler-rej.js",
    "test:gate-spread": "node tests/gate-realdevice-spread.js",
    "test:gate-creep": "node tests/gate-realdevice-creep.js",
    "test:gate-cert3env": "node tests/cert-3env-gate.js",
    "test:gate-tunnel": "node tests/gate-tunnel-continuity.js",
    "test:gate-bg-freeze": "node tests/gate-bg-freeze.js",
    "test:gate-gnss-degraded": "node tests/cert-gnss-degraded-gate.js",
    "test:cert": "npm run test:gate-snap && npm run test:sim-cert && npm run test:gate-kp && npm run test:obd-engine && npm run test:quant && npm run test:gate-doppler && npm run test:gate-cert3env",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:logic": "npm run test && npm run test:replay && npm run test:replay-display && npm run test:mm-priority",
    "check:all": "npm run check && npm run check:logic",
    "test:replay-pipeline": "node tests/replay-pipeline-distance.js",
    "test:replay-obd-main": "node tests/replay-obd-main.js",
    "test:display-even-pace": "node tests/verify-display-even-pace.js",
    "test:display-stop-restart": "node tests/verify-display-stop-restart.js",
    "test:gate-road": "node tests/gate-road-distance.js",
    "test:truedist-0610": "node tests/truedist-score-0610.js",
    "test:gate-address2": "node tests/gate-address2-accuracy.js",
    "test:gate-route-gain": "node tests/gate-route-gain.js",
    "test:replay-realdevice": "node tests/replay-realdevice.js",
    "test:gate-fare-history": "node tests/gate-fare-history.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@vitest/browser": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/web-worker": "^4.1.6",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^8.57.1",
    "fast-check": "^4.8.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^17.0.4",
    "msw": "^2.14.6",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "tsarch": "^5.4.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  }
}
